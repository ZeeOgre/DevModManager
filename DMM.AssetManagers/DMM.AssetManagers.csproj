<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;FullRelease</Configurations>
    <!-- Prevent this library from being treated as executable during publish -->
    <IsPublishable>false</IsPublishable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="niflysharp" ExcludeAssets="Compile" GeneratePathProperty="true" />
    <!-- niflysharp ships its native DLL beside the managed assembly in lib/. -->
    <Reference Include="nifly">
      <HintPath>$(Pkgniflysharp)\lib\net10.0\nifly.dll</HintPath>
    </Reference>
    <None Include="$(Pkgniflysharp)\lib\net10.0\niflycpp.dll" Link="niflycpp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DMM.Core\DMM.Core.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <Authors>ZeeOgre</Authors>
    <Company>ZeeOgre</Company>
    <Copyright>Copyright (c) ZeeOgre</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
